# ============================================================================
# إعدادات موقع «قطاعتي» — انسخ هذا الملف باسم .env ثم عدّل القيم.
#   cp .env.example .env
# ملف .env مستثنى من Git ولا يُرفع أبدًا.
# ============================================================================

# --- الربط مع منصة صفقة -----------------------------------------------------
# اتركه فارغًا لو هتربط عن طريق صفحة /admin (صفقة هتبعت المفتاح تلقائيًا).
# املأه يدويًا لو عندك المفتاح جاهز من قبل.
SAFKA_API_KEY=

# معرّف المنتج على صفقة — آخر جزء من رابط المنتج في لوحة المسوّق:
# https://aff.safka-eg.com/products/available_products/<هنا>
SAFKA_PRODUCT_ID=6a7c9cab42d4b8fe405be078

# معرّف الخاصية (property) داخل المنتج.
# اتركه فارغًا ليُختار أول خيار متاح تلقائيًا.
SAFKA_PROPERTY_ID=

# --- التسعير ----------------------------------------------------------------
SELL_PRICE=590
COMPARE_AT_PRICE=700
MAX_QTY=10

# العمولة تُحسب تلقائيًا = (SELL_PRICE − سعر المنتج على صفقة).
# املأ هذا الحقل فقط لو عايز تثبّتها بنفسك.
SAFKA_COMMISSION=

# هل يُضاف الشحن إلى حقل total المُرسل لصفقة؟
SAFKA_TOTAL_INCLUDES_SHIPPING=true

# --- بيانات الصفحة ----------------------------------------------------------
SAFKA_PAGE_NAME=قطاعتي
SAFKA_PAGE_ID=

# رابط الموقع بعد النشر — لازم يكون HTTPS عشان صفقة تقدر توصل للـ hooks.
# سيبه فارغ محليًا. على Vercel حطه: https://qata3ty.site
PUBLIC_URL=

# --- الإدارة ----------------------------------------------------------------
# كلمة سر صفحة /admin — غيّرها لأي نص طويل وعشوائي.
ADMIN_TOKEN=change-me-to-a-long-random-string

# نسخة احتياطية اختيارية من كل طلب تُرسَل كـ POST للرابط ده
# (Google Apps Script / Make / n8n). مهمة على Vercel لأن الملفات المحلية بتضيع.
ORDERS_WEBHOOK_URL=

# --- تتبّع الطلب ---------------------------------------------------------
# صفقة مالهاش نقطة API لجلب حالة طلب، فبنخزّن التحديثات اللي بيبعتوها عندنا.
# على Vercel لازم تخزين دائم وإلا الحالات بتضيع مع كل نشر.
# اربط Upstash Redis من Vercel (Storage ← Marketplace) وهو بيضيف المتغيّرين دول
# تلقائيًا — سيبهم فاضيين محليًا.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- البيكسلات والتتبّع الإعلاني ------------------------------------------
# معرّفات البيكسل عامة (بتظهر في كود الصفحة) — مش أسرار.
VITE_META_PIXEL_ID=1979727459402689
VITE_TIKTOK_PIXEL_ID=DAFKHSJC77U3EU7G6J30

# حدث الشراء عند تيك توك: PlaceAnOrder (الأدق مع الدفع عند الاستلام)
# أو CompletePayment لو حملتك متضبّطة عليه.
VITE_TIKTOK_PURCHASE_EVENT=PlaceAnOrder

# 🔴 سرّي — ده توكن Meta Conversions API (إرسال الشراء من السيرفر).
# عمره ما يوصل للمتصفح ولا يتعمله commit. لو اتسرّب غيّره من Events Manager.
META_ACCESS_TOKEN=
# كود اختبار مؤقت من Events Manager → Test Events (سيبه فاضي في الشغل الحقيقي)
META_TEST_EVENT_CODE=

# --- متقدّم -----------------------------------------------------------------
SAFKA_API_BASE=https://api.safka-eg.com
SAFKA_CONNECT_URL=https://aff.safka-eg.com/intergations/apiSafkaKeys/connect
PRODUCT_CACHE_MS=300000
SHIPPING_CACHE_MS=900000
PORT=3000
